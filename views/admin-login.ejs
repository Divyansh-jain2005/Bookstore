<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Ink & Anchor</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .display { font-family: 'Cormorant Garamond', serif; }
    </style>
</head>
<body class="min-h-screen bg-[#F3EBDD] text-[#2C2725]">
    <%- include('includes/nav.ejs') %>

    <main class="px-6 py-16">
        <section class="mx-auto max-w-md rounded-2xl border border-[#B08D57]/40 bg-[#FFFCF5] p-8 shadow-xl">
            <div class="mb-6 text-center">
                <i class="fa-solid fa-user-lock text-3xl text-[#6B2737]" aria-hidden="true"></i>
                <h1 class="display mt-3 text-4xl font-semibold text-[#3A2922]">Admin Login</h1>
                <p class="mt-2 text-sm text-[#3A2922]/65">Sign in to manage the bookstore collection.</p>
            </div>

            <% if (error) { %>
                <p role="alert" class="mb-5 rounded-lg border border-[#6B2737]/30 bg-[#6B2737]/10 px-4 py-3 text-sm text-[#6B2737]"><%= error %></p>
            <% } %>

            <form action="/admin/login" method="post" class="space-y-5">
                <div>
                    <label for="username" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-[#294536]">Username</label>
                    <input id="username" name="username" type="text" autocomplete="username" required class="w-full rounded-lg border border-[#B08D57]/45 bg-white px-4 py-3 text-sm outline-none focus:border-[#6B2737]">
                </div>
                <div>
                    <label for="password" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-[#294536]">Password</label>
                    <input id="password" name="password" type="password" autocomplete="current-password" required class="w-full rounded-lg border border-[#B08D57]/45 bg-white px-4 py-3 text-sm outline-none focus:border-[#6B2737]">
                </div>
                <button type="submit" class="w-full rounded-lg bg-[#6B2737] py-3 text-xs font-bold uppercase tracking-[0.18em] text-[#F3EBDD] transition hover:bg-[#3A2922]">Sign in</button>
            </form>
        </section>
    </main>

    <%- include('includes/footer.ejs') %>
</body>
</html>
