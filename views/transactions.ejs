<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Transactions - Ink & Anchor</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .display { font-family: 'Cormorant Garamond', serif; }
    </style>
</head>
<body class="bg-[#F3EBDD] text-[#2C2725]">
    <%- include('includes/nav.ejs') %>

    <main class="px-6 py-16">
        <div class="mx-auto max-w-6xl">
            <header class="mb-10 text-center">
                <p class="text-xs font-semibold uppercase tracking-[0.3em] text-[#6B2737]">Circulation Ledger</p>
                <h1 class="display mt-4 text-5xl text-[#3A2922] md:text-7xl">Borrow & Return Records</h1>
                <div class="mt-6 flex items-center justify-center gap-3">
                    <span class="h-px w-20 bg-[#B08D57]"></span>
                    <span class="text-[#B08D57]">✦</span>
                    <span class="h-px w-20 bg-[#B08D57]"></span>
                </div>
            </header>

            <div class="mb-10 grid gap-4 md:grid-cols-3">
                <div class="rounded-2xl border border-[#B08D57]/30 bg-white/60 p-5 shadow-sm">
                    <p class="text-[10px] uppercase tracking-[0.2em] text-[#3A2922]/60">Total Records</p>
                    <h2 class="display mt-2 text-4xl text-[#6B2737]"><%= transactions.length %></h2>
                </div>
                <div class="rounded-2xl border border-[#B08D57]/30 bg-white/60 p-5 shadow-sm">
                    <p class="text-[10px] uppercase tracking-[0.2em] text-[#3A2922]/60">Active Borrows</p>
                    <h2 class="display mt-2 text-4xl text-[#294536]"><%= activeBorrows %></h2>
                </div>
                <div class="rounded-2xl border border-[#B08D57]/30 bg-white/60 p-5 shadow-sm">
                    <p class="text-[10px] uppercase tracking-[0.2em] text-[#3A2922]/60">Returned</p>
                    <h2 class="display mt-2 text-4xl text-[#3A2922]"><%= transactions.filter(t => t.status === 'returned').length %></h2>
                </div>
            </div>

            <section class="overflow-hidden rounded-2xl border border-[#B08D57]/35 bg-[#FFFCF5] shadow-lg">
                <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-[#B08D57]/30">
                        <thead class="bg-[#E8DDC8] text-left text-[10px] font-bold uppercase tracking-[0.2em] text-[#3A2922]/60">
                            <tr>
                                <th class="px-5 py-4">Book</th>
                                <th class="px-5 py-4">User</th>
                                <th class="px-5 py-4">Status</th>
                                <th class="px-5 py-4">Date</th>
                                <th class="px-5 py-4">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#B08D57]/20 text-sm text-[#2C2725]">
                            <% if (!transactions || transactions.length === 0) { %>
                                <tr>
                                    <td colspan="5" class="px-5 py-8 text-center text-[#3A2922]/65">No circulation actions recorded yet.</td>
                                </tr>
                            <% } else { %>
                                <% transactions.forEach((transaction) => { %>
                                    <tr>
                                        <td class="px-5 py-4">
                                            <% if (transaction.book) { %>
                                                <div class="font-semibold text-[#6B2737]"><%= transaction.book.title %></div>
                                            <% } else { %>
                                                <span class="text-[#3A2922]/50">Unavailable</span>
                                            <% } %>
                                        </td>
                                        <td class="px-5 py-4"><%= transaction.userName %></td>
                                        <td class="px-5 py-4">
                                            <span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.15em] <%= transaction.status === 'borrowed' ? 'bg-[#DDE7D4] text-[#294536]' : 'bg-[#F0E0D6] text-[#6B2737]' %>">
                                                <%= transaction.status %>
                                            </span>
                                        </td>
                                        <td class="px-5 py-4">
                                            <%= new Date(transaction.createdAt).toLocaleDateString() %>
                                        </td>
                                        <td class="px-5 py-4">
                                            <% if (transaction.status === 'borrowed') { %>
                                                <form action="/transactions/return/<%= transaction._id %>" method="POST">
                                                    <button type="submit" class="rounded-lg bg-[#294536] px-3 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-[#F3EBDD] hover:bg-[#3A2922]">
                                                        Mark Returned
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="text-[#3A2922]/50">Closed</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <%- include('includes/footer.ejs') %>
</body>
</html>
