<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Book - Ink & Anchor</title>
   <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[#F3EBDD] text-[#1E1A18]">
    <%- include('includes/nav.ejs') %>

    <section class="px-6 py-16">
        <div class="max-w-3xl mx-auto">
            <div class="text-center mb-12">
                <p class="text-[#6B2737] uppercase tracking-[0.3em] text-sm mb-4">Inventory Operations</p>
                <h1 class="font-serif text-5xl text-[#3A2922]">Modify Vault Asset</h1>
                <div class="flex items-center justify-center gap-3 mt-5">
                    <span class="h-px w-20 bg-[#B08D57]"></span><span class="text-[#B08D57]">✦</span><span class="h-px w-20 bg-[#B08D57]"></span>
                </div>
            </div>

            <form action="/books/edit/<%= book._id %>" method="POST" enctype="multipart/form-data" class="bg-[#E8DDC8] border border-[#B08D57]/50 shadow-md p-8 rounded-2xl">
                <div class="mb-6">
                    <label class="block text-sm text-[#294536] font-semibold mb-2">Book Title</label>
                    <input type="text" name="title" value="<%= book.title %>" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#8C6046]/40 rounded-lg outline-none focus:border-[#6B2737]">
                </div>

                <div class="mb-6">
                    <label class="block text-sm text-[#294536] font-semibold mb-2">Author Authority</label>
                    <input type="text" name="author" value="<%= book.author %>" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#8C6046]/40 rounded-lg outline-none focus:border-[#6B2737]">
                </div>

                <div class="mb-6">
                    <label class="block text-sm text-[#294536] font-semibold mb-2">Valuation (Price ₹)</label>
                    <input type="number" name="price" value="<%= book.price %>" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#8C6046]/40 rounded-lg outline-none focus:border-[#6B2737]">
                </div>

                <div class="mb-6">
                    <label class="block text-sm text-[#294536] font-semibold mb-2">System Classification</label>
                    <select name="category" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#8C6046]/40 rounded-lg outline-none focus:border-[#6B2737]">
                        <option value="Fiction" <%= book.category === 'Fiction' ? 'selected' : '' %>>Fiction</option>
                        <option value="Fantasy" <%= book.category === 'Fantasy' ? 'selected' : '' %>>Fantasy</option>
                        <option value="Mystery" <%= book.category === 'Mystery' ? 'selected' : '' %>>Mystery</option>
                        <option value="Academics" <%= book.category === 'Academics' ? 'selected' : '' %>>Academics</option>
                    </select>
                </div>

                <div class="mb-6">
                    <label class="block text-sm text-[#294536] font-semibold mb-3">Active Visual Cover</label>
                    <img src="<%= book.image %>" alt="<%= book.title %>" class="w-40 h-52 object-cover rounded-xl shadow-md border border-[#B08D57]/30">
                </div>

                <div class="mb-8">
                    <label class="block text-sm text-[#294536] font-semibold mb-2">Replace Visual Asset</label>
                    <input type="file" name="image" accept="image/*" class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#8C6046]/40 rounded-lg">
                </div>

                <div class="flex gap-4">
                    <button type="submit" class="bg-[#6B2737] text-[#F1EACC] px-6 py-3 uppercase tracking-widest text-xs font-bold rounded-lg hover:bg-[#3A2922] transition">Commit Updates</button>
                    <a href="/books" class="border border-[#8C6046] text-[#3A2922] px-6 py-3 uppercase tracking-widest text-xs font-bold rounded-lg hover:bg-[#789165] hover:text-[#F1EACC] transition">Abort</a>
                </div>
            </form>
        </div>
    </section>

    <%- include('includes/footer.ejs') %>
</body>
</html>
